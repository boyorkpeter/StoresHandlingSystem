<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" prefHeight="580.0" prefWidth="480.0" style="-fx-background-color: #dbeafe; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.registry.storesapp.LoginController">
    <children>
        <!-- Neumorphic Floating Card with Strict Max Height to Prevent Stretching on Maximize -->
        <VBox alignment="CENTER" maxHeight="480.0" maxWidth="400.0" spacing="16.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 28px; -fx-padding: 35 30 35 30;">
            <effect>
                <DropShadow blurType="GAUSSIAN" height="35.0" radius="17.0" width="35.0">
                    <color>
                        <Color red="0.5" green="0.6" blue="0.7" opacity="0.3" />
                    </color>
                </DropShadow>
            </effect>
            <children>

                <!-- Floating Icon Container -->
                <StackPane maxHeight="56.0" maxWidth="56.0" minHeight="56.0" minWidth="56.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 28px;">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" height="12.0" radius="5.5" width="12.0">
                            <color>
                                <Color red="0.6" green="0.7" blue="0.8" opacity="0.25" />
                            </color>
                        </DropShadow>
                    </effect>
                    <children>
                        <Label text="🔒" textFill="#0284c7">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="2.0" />
                    </VBox.margin>
                </StackPane>

                <!-- Header Title -->
                <VBox alignment="CENTER" spacing="3.0">
                    <children>
                        <Label text="Welcome" textFill="#0f172a">
                            <font>
                                <Font name="Segoe UI Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Login" textFill="#64748b">
                            <font>
                                <Font name="Segoe UI" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Input Fields with Prominent Toggle Layout -->
                <VBox spacing="12.0">
                    <children>
                        <TextField fx:id="usernameField" prefHeight="46.0" promptText="Username" style="-fx-background-color: #e2e8f0; -fx-background-radius: 23px; -fx-padding: 0 20px; -fx-prompt-text-fill: #94a3b8; -fx-text-fill: #0f172a; -fx-font-size: 14px;" />

                        <!-- Password Row with Side-by-Side Toggle Button -->
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <StackPane HBox.hgrow="ALWAYS">
                                    <children>
                                        <PasswordField fx:id="passwordField" prefHeight="46.0" promptText="Password" style="-fx-background-color: #e2e8f0; -fx-background-radius: 23px; -fx-padding: 0 20px; -fx-prompt-text-fill: #94a3b8; -fx-text-fill: #0f172a; -fx-font-size: 14px;" />
                                        <TextField fx:id="visiblePasswordField" managed="false" prefHeight="46.0" promptText="Password" style="-fx-background-color: #e2e8f0; -fx-background-radius: 23px; -fx-padding: 0 20px; -fx-prompt-text-fill: #94a3b8; -fx-text-fill: #0f172a; -fx-font-size: 14px;" visible="false" />
                                    </children>
                                </StackPane>

                                <Button fx:id="togglePasswordButton" mnemonicParsing="false" onAction="#handleTogglePassword" prefHeight="46.0" prefWidth="46.0" style="-fx-background-color: #e2e8f0; -fx-background-radius: 23px; -fx-cursor: hand; -fx-text-fill: #0284c7; -fx-font-size: 16px;" text="👁">
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" height="8.0" radius="3.5" width="8.0">
                                            <color>
                                                <Color red="0.6" green="0.7" blue="0.8" opacity="0.3" />
                                            </color>
                                        </DropShadow>
                                    </effect>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </VBox>

                <!-- Error Label -->
                <Label fx:id="errorLabel" textFill="#e74c3c" visible="false" wrapText="true" style="-fx-font-weight: bold; -fx-font-size: 11.5px;" />

                <!-- Action Button -->
                <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="46.0" prefWidth="334.0" style="-fx-background-color: #0284c7; -fx-background-radius: 23px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14.5px; -fx-cursor: hand;" text="Login">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
                            <color>
                                <Color red="0.0" green="0.45" blue="0.7" opacity="0.3" />
                            </color>
                        </DropShadow>
                    </effect>
                    <VBox.margin>
                        <Insets top="2.0" />
                    </VBox.margin>
                </Button>

                <!-- Interactive Hyperlink Footer -->
                <Hyperlink fx:id="registerLink" onAction="#handleOpenRegister" text="Don't have an account? Register here" textFill="#64748b" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12.5px; -fx-border-color: transparent; -fx-cursor: hand;">
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </Hyperlink>

            </children>
        </VBox>
    </children>
</StackPane>