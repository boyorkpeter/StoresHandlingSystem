<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: #f8fafc; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.registry.storesapp.LoginController">
    <children>

        <VBox alignment="CENTER" spacing="4.0">
            <children>
                <Label text="Registry Stores System" textFill="#2c3e50">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Secure Portal Access Authentication" textFill="#64748b">
                    <font>
                        <Font name="Segoe UI" size="13.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </VBox>

        <VBox spacing="6.0">
            <children>
                <Label text="Username" textFill="#334155" style="-fx-font-weight: bold;" />
                <TextField fx:id="usernameField" prefHeight="38.0" promptText="Enter username..." style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
            </children>
        </VBox>

        <VBox spacing="6.0">
            <children>
                <Label text="Password" textFill="#334155" style="-fx-font-weight: bold;" />
                <PasswordField fx:id="passwordField" prefHeight="38.0" promptText="Enter password..." style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
            </children>
        </VBox>

        <Label fx:id="errorLabel" textFill="#e74c3c" visible="false" wrapText="true" style="-fx-font-weight: bold;" />

        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" prefWidth="340.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Authenticate Portal Session" />

    </children>
</VBox>