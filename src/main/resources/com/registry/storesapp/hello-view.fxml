<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="mainStack" alignment="TOP_LEFT" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.registry.storesapp.HelloController">

    <VBox alignment="TOP_LEFT" spacing="20.0" style="-fx-background-color: transparent;" stylesheets="@style.css" maxWidth="Infinity" maxHeight="Infinity">
        <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
        </padding>

        <Label text="Registry Stores Management System" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
            <effect>
                <DropShadow blurType="GAUSSIAN" color="WHITE" height="15.0" radius="7.0" width="15.0" />
            </effect>
            <VBox.margin>
                <Insets left="5.0" />
            </VBox.margin>
        </Label>

        <SplitPane fx:id="sideSplitPane" dividerPositions="1.0" style="-fx-background-color: transparent; -fx-box-border: transparent;" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
            <items>

                <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" SplitPane.resizableWithParent="true">
                    <tabs>
                        <Tab text="Inventory Management">
                            <VBox styleClass="tab-content-holder" spacing="15.0" style="-fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 12, 0, 0, 2);" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                                <Separator prefWidth="200.0" />

                                <HBox alignment="CENTER" spacing="30.0">
                                    <VBox alignment="CENTER" prefWidth="240.0" style="-fx-background-color: rgba(41, 128, 185, 0.12); -fx-background-radius: 12; -fx-border-color: rgba(41, 128, 185, 0.25); -fx-border-radius: 12; -fx-padding: 15;">
                                        <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14px;" text="Total Items" />
                                        <Label fx:id="totalItemsLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" text="0" />
                                    </VBox>
                                    <Separator orientation="VERTICAL" />
                                    <VBox alignment="CENTER" prefWidth="240.0" style="-fx-background-color: rgba(230, 126, 34, 0.12); -fx-background-radius: 12; -fx-border-color: rgba(230, 126, 34, 0.25); -fx-border-radius: 12; -fx-padding: 15;">
                                        <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14px;" text="Low Stock Items" />
                                        <Label fx:id="lowStockLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" text="0" />
                                    </VBox>
                                    <Separator orientation="VERTICAL" />
                                    <VBox alignment="CENTER" prefWidth="240.0" style="-fx-background-color: rgba(231, 76, 60, 0.12); -fx-background-radius: 12; -fx-border-color: rgba(231, 76, 60, 0.25); -fx-border-radius: 12; -fx-padding: 15;">
                                        <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14px;" text="Out of Stock" />
                                        <Label fx:id="outOfStockLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #c0392b;" text="0" />
                                    </VBox>
                                </HBox>

                                <Separator />

                                <HBox alignment="CENTER" spacing="12.0">
                                    <TextField fx:id="nameInput" prefHeight="40.0" prefWidth="240.0" promptText="Item Name" />
                                    <ComboBox fx:id="categoryInput" prefHeight="40.0" prefWidth="150.0" promptText="Category" />
                                    <TextField fx:id="stockInput" prefHeight="40.0" prefWidth="100.0" promptText="Initial Qty" />
                                    <ComboBox fx:id="unitInput" prefHeight="40.0" prefWidth="130.0" promptText="Unit Type" />
                                    <TextField fx:id="thresholdInput" prefHeight="40.0" prefWidth="110.0" promptText="Alert Limit" />
                                    <Button onAction="#handleAddItem" prefHeight="40.0" style="-fx-background-color: #1b5e20; -fx-text-fill: white;" styleClass="button" text="Register New Item" />
                                </HBox>

                                <Separator />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 13px;" text="Search Inventory:" />
                                    <TextField fx:id="searchField" prefHeight="35.0" prefWidth="380.0" promptText="Filter by item name or category..." />
                                </HBox>

                                <TableView fx:id="itemTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="nameColumn" prefWidth="450.0" text="Item Name" />
                                        <TableColumn fx:id="categoryColumn" prefWidth="250.0" text="Category" />
                                        <TableColumn fx:id="stockColumn" prefWidth="250.0" text="Stock Quantity" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <Button onAction="#handleDeleteItem" styleClass="clear-button" text="Delete Item" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button onAction="#handleLowStockReport" style="-fx-background-color: #d35400; -fx-text-fill: white;" styleClass="button" text="Low Stock Report" />
                                    <Separator orientation="VERTICAL" />
                                    <Button onAction="#handleShowStockInPane" style="-fx-background-color: #27ae60; -fx-text-fill: white;" styleClass="button" text="Stock In (GRN)" />
                                    <Separator orientation="VERTICAL" />
                                    <Button onAction="#handleShowIssuePane" style="-fx-background-color: #2980b9; -fx-text-fill: white;" styleClass="button" text="Issue Item" />
                                    <Separator orientation="VERTICAL" />
                                    <Button onAction="#refreshData" styleClass="standard-button" text="Refresh" />
                                </HBox>
                            </VBox>
                        </Tab>

                        <Tab text="Transaction History (Flow)">
                            <VBox styleClass="tab-content-holder" spacing="15.0" style="-fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 12, 0, 0, 2);" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                                <Separator prefWidth="200.0" />
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Label style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 15px;" text="Audit Trail: Recent Stock Movements" />
                                    <Region HBox.hgrow="ALWAYS" />

                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label style="-fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Filter Flow:" />
                                        <ComboBox fx:id="flowTypeFilterComboBox" onAction="#handleFlowTypeFilterChanged" prefHeight="35.0" prefWidth="140.0" promptText="All Movements" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label style="-fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Search History:" />
                                        <TextField id="historySearchField" fx:id="historySearchField" prefHeight="35.0" prefWidth="260.0" promptText="Search item, name, dept..." />
                                    </HBox>
                                </HBox>
                                <Separator prefWidth="200.0" />

                                <TableView fx:id="logTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="typeCol" prefWidth="130.0" text="Flow Type" />
                                        <TableColumn fx:id="logIdCol" prefWidth="320.0" text="Stationery Name" />
                                        <TableColumn fx:id="qtyCol" prefWidth="100.0" text="Qty" />
                                        <TableColumn fx:id="supplierCol" prefWidth="220.0" text="Supplier" />
                                        <TableColumn fx:id="recipientCol" prefWidth="220.0" text="Recipient" />
                                        <TableColumn fx:id="dateCol" prefWidth="220.0" text="Date &amp; Time" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <Button onAction="#handleExportAuditToExcel" style="-fx-background-color: #27ae60; -fx-text-fill: white;" styleClass="button" text="Export Selection to Excel (.xlsx)" />
                                    <Separator orientation="VERTICAL" />
                                    <Button onAction="#handleCompileFilteredPDFReport" style="-fx-background-color: #c0392b; -fx-text-fill: white;" styleClass="button" text="Print Filtered Summary (PDF)" />
                                    <Separator orientation="VERTICAL" />
                                    <Button onAction="#handlePrintSelectedVoucher" style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" styleClass="button" text="Print Single Voucher (PDF)" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button onAction="#handleClearHistory" styleClass="clear-button" text="Clear History" />
                                    <Separator orientation="VERTICAL" />
                                    <Button onAction="#refreshData" styleClass="standard-button" text="Refresh Audit Trail" />
                                </HBox>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>

                <VBox fx:id="slidingFormPane" maxWidth="380.0" minWidth="0.0" prefWidth="350.0" styleClass="tab-content-holder" spacing="20.0" style="-fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 2);" SplitPane.resizableWithParent="false">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="formPaneTitle" text="Stock Allocation Form" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleCloseSlidingPane" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-padding: 0 5 0 5;" text="✕" />
                            </children>
                        </HBox>

                        <Separator />

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Selected Stationery:" textFill="#475569" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextField fx:id="formItemNameField" editable="false" prefHeight="38.0" style="-fx-opacity: 0.85;" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Transaction Target Quantity:" textFill="#475569" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextField fx:id="formQuantityField" prefHeight="38.0" promptText="Enter piece count..." />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label fx:id="formEntityLabel" text="Supplier / Vendor:" textFill="#475569" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="formEntityComboBox" editable="true" maxWidth="Infinity" prefHeight="38.0" promptText="Type or select entity..." />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleCloseSlidingPane" styleClass="standard-button" text="Cancel" prefHeight="40.0" />
                                <Button fx:id="formActionButton" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleExecuteFormAction" style="-fx-background-color: #2980b9; -fx-text-fill: white;" styleClass="button" text="Confirm Transaction" prefHeight="40.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </items>
        </SplitPane>
    </VBox>
</StackPane>